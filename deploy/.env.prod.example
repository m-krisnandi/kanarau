# Konfigurasi Production Kanarau API (Otomatis Dibuat via Docker Compose)

# Port aplikasi backend
SERVER_PORT=8085

# Password Database PostgreSQL (Database 'kanarau' akan otomatis dibuat oleh Docker)
DB_PASSWORD=GantiPasswordKuatKanarau123!

# JWT Secret untuk autentikasi login (minimal 32 karakter acak)
JWT_SECRET=rahasia-jwt-kanarau-production-minimal-256-bit-key-harus-panjang-dan-acak-12345
JWT_EXPIRATION_MS=86400000

# CORS Origins (domain frontend Vercel dan custom subdomain Anda)
KANARAU_CORS_ORIGINS=https://kanarau.pdfumi.com,https://kanarau.vercel.app,https://*.vercel.app
